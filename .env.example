# ==============================================================================
# MCA SMART CAMPUS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for local development or configure these variables
# in your hosting platform's secret manager for production.
# NEVER commit real secrets, database credentials, or SMTP passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django Environment & Security
# ------------------------------------------------------------------------------
# Allowed values: development | production
DJANGO_ENV="development"

# Must be False in production
DJANGO_DEBUG="True"

# Required in production: generate a unique 50+ character random key
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY="CHANGE_ME_TO_A_50_PLUS_CHAR_RANDOM_SECRET"

# Comma-separated hostnames (in production, set to your actual domain, never "*")
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# Comma-separated HTTPS origins in production (e.g. https://campus.yourdomain.edu)
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:8000"

# Set to True in production behind HTTPS / TLS-terminating proxy
DJANGO_SECURE_SSL_REDIRECT="False"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Leave empty for local SQLite (db.sqlite3).
# For PostgreSQL in production:
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 3. Development-Only Demo Portal Access (MUST remain False in production)
# ------------------------------------------------------------------------------
# Explicitly opt in for local development only (requires DJANGO_DEBUG=True)
DEMO_MODE="False"
DEMO_PORTAL_ACCESS="False"
DEMO_PORTAL_ALLOWED_HOSTS="localhost,127.0.0.1,testserver"

# ------------------------------------------------------------------------------
# 4. Cookie Encryption & Remember-Me Settings
# ------------------------------------------------------------------------------
# Must be a strong 32+ char secret DISTINCT from DJANGO_SECRET_KEY in production
COOKIE_ENCRYPTION_SECRET="CHANGE_ME_TO_A_DISTINCT_32_PLUS_CHAR_SECRET"

# Remember-Me session & encrypted username cookie duration in days (1-365)
REMEMBER_ME_DAYS="30"

# ------------------------------------------------------------------------------
# 5. SMTP Email Configuration (Password Reset & Notifications)
# ------------------------------------------------------------------------------
# Use SMTP_PORT=587 with SMTP_SECURE=false for STARTTLS,
# or SMTP_PORT=465 with SMTP_SECURE=true for implicit SSL.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MCA Smart Campus Security <no-reply@mcasmartcampus.edu>"

# ------------------------------------------------------------------------------
# 6. AI Studio / Express Runtime Variables
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
